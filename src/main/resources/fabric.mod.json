{
	"schemaVersion": 1,
	"id": "fullscreenfix",
	"version": "2.2.1",
	"name": "Borderless Fullscreen",
	"description": "This mod changes Minecraft's fullscreen mode and makes it more customizable. By default, it makes the game not minimize on lost focus, and allows other windows on top of the game.",
	"authors": [
		"Bestsoft100"
	],
	"contact": {
		"homepage": "https://github.com/Bestsoft101/Better-Fullscreen",
		"sources": "https://github.com/Bestsoft101/Better-Fullscreen",
		"issues": "https://github.com/Bestsoft101/Better-Fullscreen/issues"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.modrinth": "https://modrinth.com/project/borderless-fullscreen"
			}
		}
	},
	"environment": "client",
	"entrypoints": {
		"modmenu": [
			"b100.fullscreenfix.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "fullscreenfix.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "fullscreenfix.accesswidener",
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": ">=1.21 <=1.21.1",
		"java": ">=21",
		"b100lib": ">=0.1 <0.2"
	}
}
